# Copy to .env and adjust. Loaded by every script via scripts/_common.sh.
# .env is gitignored — the LiteLLM key lives here, not in tracked files.

# --- Databricks control plane ---
DATABRICKS_PROFILE=llm
WORKSPACE_HOST=https://llms.cloud.databricks.com
CATALOG=llm_catalog
SCHEMA=gateway_link
SERVICE_ID=litellm_local

# --- LiteLLM + edge proxy (local) ---
# The upstream key the gateway presents to LiteLLM (LiteLLM's own master_key).
LITELLM_MASTER_KEY=sk-litellm-test-1234
LITELLM_PORT=4000      # LiteLLM proxy port
EDGE_PORT=8899         # logging edge proxy port (this is what cloudflared exposes)
OLLAMA_HOST=http://localhost:11434

# --- Databricks AI Gateway request tags ---
# Static attribution tags the CLIENT sends on the request; the gateway records
# them in system.ai_gateway.usage.request_tags (map<string,string>). Values must
# be strings. Cost is NOT here because it isn't known until after inference —
# the edge proxy adds cost tags on the response as an experiment (see edge_proxy.py).
# Single-quote the JSON so bash keeps the inner double quotes.
GATEWAY_REQUEST_TAGS='{"team":"llm_testers","project":"tag_req_resp","environment":"local"}'
